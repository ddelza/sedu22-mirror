  "boardName": "독서연계 과학수업",
  "title": "과학독서반 12월 활동",
  "author": "박혜은(신서중)",
  "userid": "1st8c",
  "created": "16.12.08",
  "viewCnt": 2791,
  "commentCnt": 8,
