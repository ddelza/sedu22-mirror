, \"al\": 0, \"ui\": true, \"ai\": true, \"wa\": 0, \"tt\": 0, \"to\": 50, \"cp\": \"\", \"uf\": 8, \"st\": 1, \"sf\": \"(^6)\" }, { \"le\": 7, \"al\": 0, \"ui\": true, \"ai\": true, \"wa\": 0, \"tt\": 0, \"to\": 50, \"cp\": \"\", \"uf\": 1, \"st\": 1, \"sf\": \"^7\" }, { \"le\": 8, \"al\": 0, \"ui\": false, \"ai\": false, \"wa\": 0, \"tt\": 0, \"to\": 0, \"cp\": \"01D5CDFAC40E3080000000A4\", \"uf\": 0, \"st\": 1, \"sf\": \"\" }, { \"le\": 9, \"al\": 0, \"ui\": false, \"ai\": false, \"wa\": 0, \"tt\": 0, \"to\": 0, \"cp\": \"01D5CDFAC40E3080000000A4\", \"uf\": 0, \"st\": 1, \"sf\": \"\" }, { \"le\": 10, \"al\": 0, \"ui\": false, \"ai\": false, \"wa\": 0, \"tt\": 0, \"to\": 0, \"cp\": \"01D5CDFAC40E3080000000A4\", \"uf\": 0, \"st\": 1, \"sf\": \"\" } ] } }, \"bu\": { }, \"pp\": { \"01D5CDFAC40E3080000000A7\": { \"id\": 0, \"ah\": 0, \"av\": 0, \"ht\": 0, \"hi\": \"\", \"hl\": 0, \"tp\": \"01D5CDFAC40E3080000000A5\", \"kb\": 0, \"kn\": true, \"ko\": false, \"kk\": false, \"kl\": false, \"kp\": false, \"kw\": 0, \"co\": 0, \"fl\": false, \"st\": true, \"sl\": false, \"ae\": false, \"aa\": false, \"mi\": 0, \"ml\": 0, \"mr\": 0, \"mp\": 0, \"mn\": 0, \"lt\": 0, \"lv\": 160, \"bf\": \"01D5CDFAC40E3080000000A3\", \"bl\": 0, \"br\": 0, \"bt\": 0, \"bb\": 0, \"bc\": false, \"bi\": false } }, \"st\": { \"01D5CDFAC40E3080000000A8\": { \"id\": 0, \"ty\": 0, \"na\": \"바탕글\", \"en\": \"Normal\", \"pp\": \"01D5CDFAC40E3080000000A7\", \"cp\": \"01D5CDFAC40E3080000000A4\", \"ns\": \"01D5CDFAC40E3080000000A8\", \"li\": 1042, \"lf\": false } }, \"mp\": { }, \"ro\": { \"hp\": \"01D5CDFAC40E30800000009B\", \"01D5CDFAC40E30800000009B\": { \"np\": \"01D5CDFAC40E30800000009C\", \"id\": 0, \"pp\": \"01D5CDFAC40E3080000000A7\", \"si\": \"01D5CDFAC40E3080000000A8\", \"bf\": 3, \"ru\": [ { \"cp\": \"01D5CDFAC40E3080000000A4\", \"ch\": [ { \"cc\": 2, \"ci\": 1936024420, \"co\": \"01D5CDFAC40E308000000099\" } , { \"cc\": 2, \"ci\": 1668246628, \"co\": \"01D5CDFAC40E30800000009A\" } , { \"t\": \"2년간 과학콘서트, 코스모스, 호모데우스 등의 책을 통해 과학독서토론에 참여했습니다. 딱딱하게만 생각했던 ‘토론’이라는 활동이었지만 자유롭게 의견을 낼 수 있는 분위기라서 부담 없이 즐겁게 참여할 수 있었습니다.\" } ] } ] }, \"01D5CDFAC40E30800000009C\": { \"np\": \"01D5CDFAC40E30800000009D\", \"id\": -2147483648, \"pp\": \"01D5CDFAC40E3080000000A7\", \"si\": \"01D5CDFAC40E3080000000A8\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D5CDFAC40E3080000000A4\", \"ch\": [ { \"t\": \"평소에는 객관적이고 명료한 주제라고 생각했던 ‘과학’이 소재여서 더욱 좋았습니다. 문, 이과가 나누어져 있는 고등학교에서 배우고 생활하다보니 자연적으로 과학과 인문을 동떨어진 것으로 생각하게 되었는데, 토론 수업을 통해 그런 방면에서 보다 더 유연하고 자유롭게 사고할 수 있었습니다. 특히 ‘코스모스’에서 이걸 많이 느꼈습니다. 우주에 대한 책에서 대체 무슨 얘깃거리가 나올까 했는데 사회적인 토론거리가 많이 나오는 게 정말 흥미로웠습니다.\" } ] } ] }, \"01D5CDFAC40E30800000009D\": { \"np\": \"01D5CDFAC40E30800000009E\", \"id\": -2147483648, \"pp\": \"01D5CDFAC40E3080000000A7\", \"si\": \"01D5CDFAC40E3080000000A8\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D5CDFAC40E3080000000A4\", \"ch\": [ { \"t\": \"\" } ] } ] }, \"01D5CDFAC40E30800000009E\": { \"np\": \"01D5CDFAC40E30800000009F\", \"id\": -2147483648, \"pp\": \"01D5CDFAC40E3080000000A7\", \"si\": \"01D5CDFAC40E3080000000A8\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D5CDFAC40E3080000000A4\", \"ch\": [ { \"t\": \"제가 가장 좋아하는 활동은 학생들이 번갈아가며 토론 주제를 정하는 자율적인 발제 활동이었습니다. 주제를 저희가 정할 수 있었기에 무엇이 옳다면 그 반대는 반드시 틀리게 되는 토론이 아닌 모든 의견이 다 맞는 토론을 진행할 수 있었던 것 같습니다. 또, 발제를 준비하며 책의 작은 부분에도 호기심을 갖는 습관을 들이게 되었습니다. 이 부분이 제게는 가장 큰 도움이 되었습니다. 인문학, 자연과학 같은 분야는 읽는 이로 하여금 주어진 지식을 그대로 받아들이게 하는 경향이 강하고, 특히 책읽기가 미숙한 학생들은 아무리 ‘자신만의 재해석’에 대해 배워도 그것을 잘 이용하지 못합니다. 하지만 발제를 준비하기 위해서는 필연적으로 책의 내용에 대해 의문을 갖고, 그 의문에 대한 자신의 답을 내놓음으로써 그 지식을 ‘자신의 것으로 만드는’ 과정이 필요했습니다. 저는 이게 이 독서토론의 가장 큰 이점이었다고 생각합니다. 스스로 생각하는 능력은 오로지 체감을 통해서만 습득할 수 있기 때문입니다.\" } ] } ] }, \"01D5CDFAC40E30800000009F\": { \"np\": \"01D5CDFAC40E3080000000A0\", \"id\": -2147483648, \"pp\": \"01D5CDFAC40E3080000000A7\", \"si\": \"01D5CDFAC40E3080000000A8\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D5CDFAC40E3080000000A4\", \"ch\": [ { \"t\": \"그리고 이건 지극히 개인적인 생각일지도 모르겠지만, 토론 주제가 당일에 발표되어 발제자 외의 학생들은 비교적 짧은 시간 내에 자신의 의견을 정해야하는 것도 좋았습니다. 일반적인 토론처럼 오랜 기간에 걸쳐 자료를 모으고 그 자료로 자신의 의견을 객관화하여 말할 필요가 없어 상상력을 펼칠 기회가 많았던 것 같습니다. 인터넷 블로그에서 긁어온 단일화된 근거가 아닌 자신만의 근거로 의견을 펼치는 토론은 말하는 학생에게도 듣는 학생에게도 재미있는 경험이었을 거라고 생각합니다. 그리고 제겐, 인터넷에서 찾아내어 종이 한 장 위에 요약해놓은 정보들 없이도 내가 이만큼 생각하고 또 말할 수 있다는 것을 알게 되는 시간이었습니다. 저는 원래 사람들 앞에 서서 말하는 걸 굉장히 어려워하는데, 토론을 하며 말하기에 자신감을 많이 붙여 페임랩 같이 발표가 주를 이루는 대회에도 나가보는 등 여러 가지로 도움을 많이 받았습니다.\" } ] } ] }, \"01D5CDFAC40E3080000000A0\": { \"np\": \"01D5CDFAC40E3080000000A1\", \"id\": -2147483648, \"pp\": \"01D5CDFAC40E3080000000A7\", \"si\": \"01D5CDFAC40E3080000000A8\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D5CDFAC40E3080000000A4\", \"ch\": [ { \"t\": \"\" } ] } ] }, \"01D5CDFAC40E3080000000A1\": { \"np\": \"\", \"id\": -2147483648, \"pp\": \"01D5CDFAC40E3080000000A7\", \"si\": \"01D5CDFAC40E3080000000A8\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D5CDFAC40E3080000000A4\", \"ch\": [ { \"t\": \"아쉬운 점을 말해달라고 하셨는데 매 순간이 즐거웠던 만큼 아쉬운 점은 없었습니다. 굳이 뽑아보자면 ‘코스모스’ 같이 책의 주제가 하나인 경우 뒤로 갈수록 토론 주제들이 비슷해졌다는 점 정도입니다. 다만 이건 ‘코스모스’의 중후반부에 외계 생명체의 존재에 대해 긍정하는 듯한 말이 많이 나와 어쩔 수 없었던 부분이었지 않았나 싶기도 합니다. 그래도 혹시 앞으로 이런 이유로 토론 주제가 두세 번 중복된다면 ‘이 챕터에서는 이런 부분에 중점을 두고 읽으면 좋을 것 같다’같은 작은 언질로 조금 가이드라인을 주시면 어떨까 생각해봤습니다.\" } ] } ] } }, \"sl\": { }, \"cs\": { \"01D5CDFAC40E308000000099\": { \"cc\": 2, \"ci\": 1936024420, \"td\": 0, \"tv\": false, \"sc\": 1134, \"ts\": 8000, \"ms\": \"\", \"os\": \"01D5CDFAC40E3080000000A6\", \"gl\": 0, \"gc\": 0, \"gw\": false, \"ns\": 0, \"np\": 0, \"ni\": 0, \"nt\": 0, \"ne\": 0, \"hh\": false, \"hf\": false, \"hm\": false, \"fb\": false, \"hb\": false, \"fi\": false, \"hi\": false, \"hp\": false, \"he\": false, \"sl\": false, \"lr\": 0, \"lc\": 0, \"ld\": 0, \"ls\": 0, \"pp\": { \"ls\": false, \"wi\": 59528, \"he\": 84188, \"gt\": 0, \"ml\": 8504, \"mr\": 8504, \"mt\": 5668, \"mb\": 4252, \"mh\": 4252, \"mf\": 4252, \"mg\": 0 }, \"fn\": { \"at\": 0, \"au\": \"\", \"ap\": \"\", \"ac\": \")\", \"as\": false, \"ll\": -1, \"lt\": 1, \"lw\": 1, \"lc\": 0, \"sa\": 850, \"sb\": 567, \"st\": 283 , \"nt\": 0, \"