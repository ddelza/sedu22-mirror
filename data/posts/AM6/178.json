  "contentHtml": "<P style=\"LETTER-SPACING: 0pt; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt; mso-font-width: 100%; mso-text-raise: 0pt\" class=0><SPAN style=\"mso-fareast-font-family: 함초롬바탕\">최근에 </SPAN></P>\r\n<P style=\"LETTER-SPACING: 0pt; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt; mso-font-width: 100%; mso-text-raise: 0pt\" class=0><SPAN style=\"mso-fareast-font-family: 함초롬바탕\">미국과학교과서를 몇 권 읽게 되었는데요.</SPAN></P>\r\n<P style=\"LETTER-SPACING: 0pt; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt; mso-font-width: 100%; mso-text-raise: 0pt\" class=0>&nbsp;</P>\r\n<P style=\"LETTER-SPACING: 0pt; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt; mso-font-width: 100%; mso-text-raise: 0pt\" class=0><SPAN style=\"mso-fareast-font-family: 함초롬바탕\">교과서에 등장하는 미국 지형, 건물, 시설 사진들을 보니 </SPAN></P>\r\n<P style=\"LETTER-SPACING: 0pt; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt; mso-font-width: 100%; mso-text-raise: 0pt\" class=0><SPAN style=\"mso-fareast-font-family: 함초롬바탕\">참 반가웠습니다.</SPAN></P>\r\n<P style=\"LETTER-SPACING: 0pt; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt; mso-font-width: 100%; mso-text-raise: 0pt\" class=0>&nbsp;</P>\r\n<P style=\"LETTER-SPACING: 0pt; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt; mso-font-width: 100%; mso-text-raise: 0pt\" class=0><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: Gulim,굴림,AppleGothic,sans-serif; FONT-SIZE: 10pt; mso-font-width: 100%; mso-text-raise: 0pt\">Teton National Park in Wyoming</SPAN></P>\r\n<P style=\"TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"FONT-FAMILY: 함초롬바탕\"><SPAN style=\"FONT-FAMILY: Gulim,굴림,AppleGothic,sans-serif; FONT-SIZE: 10pt\">&nbsp; </SPAN></SPAN></P>\r\n<P style=\"LETTER-SPACING: 0pt; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt; mso-font-width: 100%; mso-text-raise: 0pt\" class=0><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: Gulim,굴림,AppleGothic,sans-serif; FONT-SIZE: 10pt; mso-font-width: 100%; mso-text-raise: 0pt\">Arches National Park in Utah</SPAN></P>\r\n<P style=\"TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"FONT-FAMILY: 함초롬바탕\"><SPAN style=\"FONT-FAMILY: Gulim,굴림,AppleGothic,sans-serif; FONT-SIZE: 10pt\">&nbsp; </SPAN></SPAN></P>\r\n<P style=\"TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"FONT-FAMILY: 함초롬바탕\"><SPAN style=\"FONT-FAMILY: Gulim,굴림,AppleGothic,sans-serif; FONT-SIZE: 10pt\">Death Valley, California</SPAN></SPAN></P>\r\n<P style=\"TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0>&nbsp;</P>\r\n<P style=\"LETTER-SPACING: 0pt; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt; mso-font-width: 100%; mso-text-raise: 0pt\" class=0><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: Gulim,굴림,AppleGothic,sans-serif; FONT-SIZE: 10pt; mso-font-width: 100%; mso-text-raise: 0pt\">Canyonlands National Park, Utah</SPAN></P>\r\n<P style=\"TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"FONT-FAMILY: 함초롬바탕\"><SPAN style=\"FONT-FAMILY: Gulim,굴림,AppleGothic,sans-serif; FONT-SIZE: 10pt\">&nbsp; </SPAN></SPAN></P>\r\n<P style=\"LETTER-SPACING: 0pt; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt; mso-font-width: 100%; mso-text-raise: 0pt\" class=0><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: Gulim,굴림,AppleGothic,sans-serif; FONT-SIZE: 10pt; mso-font-width: 100%; mso-text-raise: 0pt\">Wind turbines in California</SPAN></P>\r\n<P style=\"TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"FONT-FAMILY: 함초롬바탕\"><SPAN style=\"FONT-FAMILY: Gulim,굴림,AppleGothic,sans-serif; FONT-SIZE: 10pt\">&nbsp; </SPAN></SPAN></P>\r\n<P style=\