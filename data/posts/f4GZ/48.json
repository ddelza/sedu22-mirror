gin-right: 10px;margin-top: 10px;\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/34f033f743b1ca19b1ed98bcfe6a7be28741759c\" class=\"txc-image-grid\"></span><span data-url=\"https://t1.daumcdn.net/cafeattach/1TaBA/66b6559a53ae217fb01c7a77cd78d495ec78c358\" data-origin-width=\"4000\" data-origin-height=\"3000\" style=\"width:48.51%; margin-top: 10px;\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/66b6559a53ae217fb01c7a77cd78d495ec78c358\" class=\"txc-image-grid\"></span></div><div class=\"image-container\"><span data-url=\"https://t1.daumcdn.net/cafeattach/1TaBA/aee5b49e0bec380e6bff02aa6736409c1bcf6e67\" data-origin-width=\"3952\" data-origin-height=\"2792\" style=\"width:33.75%; margin-right: 10px;margin-top: 10px;\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/aee5b49e0bec380e6bff02aa6736409c1bcf6e67\" class=\"txc-image-grid\"></span><span data-url=\"https://t1.daumcdn.net/cafeattach/1TaBA/e025e86b0cfbe9b2fcba1066c0e368abf5c94932\" data-origin-width=\"3594\" data-origin-height=\"2610\" style=\"width:32.83%; margin-right: 10px;margin-top: 10px;\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/e025e86b0cfbe9b2fcba1066c0e368abf5c94932\" class=\"txc-image-grid\"></span><span data-url=\"https://t1.daumcdn.net/cafeattach/1TaBA/1d2fa0fb5b58271be0ff33daa87eef3cc9a06b9d\" data-origin-width=\"3952\" data-origin-height=\"2820\" style=\"width:33.42%; margin-top: 10px;\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/1d2fa0fb5b58271be0ff33daa87eef3cc9a06b9d\" class=\"txc-image-grid\"></span></div><div class=\"image-container\"><span data-url=\"https://t1.daumcdn.net/cafeattach/1TaBA/662934b0f51737c08e62b892b9876640f9f9d9e4\" data-origin-width=\"3799\" data-origin-height=\"2704\" style=\"width:49.92%; margin-right: 10px;margin-top: 10px;\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/662934b0f51737c08e62b892b9876640f9f9d9e4\" class=\"txc-image-grid\"></span><span data-url=\"https://t1.daumcdn.net/cafeattach/1TaBA/4b33ec998de61323d2581c8e33df2176e3bf905c\" data-origin-width=\"3756\" data-origin-height=\"2665\" style=\"width:50.08%; margin-top: 10px;\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/4b33ec998de61323d2581c8e33df2176e3bf905c\" class=\"txc-image-grid\"></span></div><div class=\"image-container\"><span data-url=\"https://t1.daumcdn.net/cafeattach/1TaBA/75758fb82cf33b9f875dcb103f31b7e8f051ac20\" data-origin-width=\"4000\" data-origin-height=\"3000\" style=\"width:49.36%; margin-right: 10px;margin-top: 10px;\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/75758fb82cf33b9f875dcb103f31b7e8f051ac20\" class=\"txc-image-grid\"></span><span data-url=\"https://t1.daumcdn.net/cafeattach/1TaBA/eccc7931e7bd619dc777a73ebff4e3919156f99d\" data-origin-width=\"3952\" data-origin-height=\"2889\" style=\"width:50.64%; margin-top: 10px;\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/eccc7931e7bd619dc777a73ebff4e3919156f99d\" class=\"txc-image-grid\"></span></div><div class=\"image-container\"><span data-url=\"https://t1.daumcdn.net/cafeattach/1TaBA/39f8acb138cf2ad82885c4a9bc729d737e23129b\" data-origin-width=\"3952\" data-origin-height=\"2889\" style=\"width:57.77%; margin-right: 10px;margin-top: 10px;\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/39f8acb138cf2ad82885c4a9bc729d737e23129b\" class=\"txc-image-grid\"></span><span data-url=\"https://t1.daumcdn.net/cafeattach/1TaBA/feca2646e3f692545ec4d93fe46725b15f19f92f\" data-origin-width=\"2880\" data-origin-height=\"2880\" style=\"width:42.23%; margin-top: 10px;\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/feca2646e3f692545ec4d93fe46725b15f19f92f\" class=\"txc-image-grid\"></span></div><div class=\"figcaption\"></div></div><p style=\"text-align: left;\"></p><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/abc12331a4d80f4a16d7169e00f26ab7dd9c26a7\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/abc12331a4d80f4a16d7169e00f26ab7dd9c26a7\" data-origin-width=\"1486\" data-origin-height=\"417\"></div><p style=\"text-align: left;\"><b><br>색깔비율) 3.46 : 1<br><br>모양비율) 2.77 : 1<br><br>R_Y_  : rrY_ : R_yy : rryy = 9.47 : 3.5 : 3 : 1</b><br><br>제 기대 이상으로 이론에 가까운 비율이 나왔습니다!<br></p><div data-ke-type=\"emoticon\" data-ke-style=\"alignCenter\" data-emoticon-type=\"niniz\" data-emoticon-name=\"043\" data-emoticon-isanimation=\"true\" data-emoticon-src=\"https://t1.daumcdn.net/keditor/emoticon/niniz/large/043.gif\"><img src=\"https://t1.daumcdn.net/keditor/emoticon/niniz/large/043.gif\"></div><p style=\"text-align: left;\"><br>《댓글보고 찾아본 멘델의 실제 실험결과와 비교》</p><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/fba63ff7c9a7968a340b2d8d6b4491e30ecdb10f\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/fba63ff7c9a7968a340b2d8d6b4491e30ecdb10f\" data-origin-width=\"902\" data-origin-height=\"737\"></div><p style=\"text-align: left;\"><br><br>올해를 마지막으로 멘델프로젝트를 끝내기로 했는데 <br>결과까지 만족스럽게 나와서 <br>미련없이 마무리지을 수 있을 것 같습니다.^^<br><br>올해도 70여개 학교 선생님들이 함께 해주셨는데<br>다른 선생님들의 결과도 너무 궁금하네요~<br><br>여기 게시판에 있는 내용들만 보셔도 충분히 따라하실 수 있으니 관심있는 선생님들이 계시면 멘델프로젝트를 죽 이어가주시면 좋겠네요~ n값이 커질수록 비율이 이론에 가깝게 나올테니까요.ㅎ<br><br>자세한 기록은 패들렛을 참고하세요^^<br><a href=\"https://padlet.com/kimjjang28/2023-yj8ecydgpzip6btj\" target=\"_blank\" class=\"ke-link\">https://padlet.com/kimjjang28/2023-yj8ecydgpzip6btj</a></p><div class=\"figure-open\" contenteditable=\"false\" data-ke-type=\"opengraph\" data-ke-align=\"alignCenter\" data-og-type=\"website\" data-og-title=\"2023 범계중 멘델프로젝트\" data-og-description=\"멘델의 유전법칙 확인을 위한 완두 교배 실험 과정 공유\" data-og-host=\"padlet.com\" data-og-source-url=\"https://padlet.com/kimjjang28/2023-yj8ecydgpzip6btj\" data-og-url=\"https://padlet.com/kimjjang28/2023-yj8ecydgpzip6btj\" data-og-image=\"http://scrap.kakaocdn.net/dn/cbDnwA/hyS5t864oM/Q51kzI507ni3ECXV9UQDh0/im