29419200000001A\", \"li\": 1042, \"lf\": false } }, \"mp\": { }, \"ro\": { \"hp\": \"01D66BABF293CB0000000003\", \"01D66BABF293CB0000000003\": { \"np\": \"01D66BABF293CB0000000004\", \"id\": 0, \"pp\": \"01D66BABF294192000000019\", \"si\": \"01D66BABF29419200000001A\", \"bf\": 3, \"ru\": [ { \"cp\": \"01D66BABF294192000000015\", \"ch\": [ { \"cc\": 2, \"ci\": 1936024420, \"co\": \"01D66BABF293CB0000000000\" } , { \"cc\": 2, \"ci\": 1668246628, \"co\": \"01D66BABF293CB0000000001\" } , { \"t\": \" 예술중학교와 체육중학교는 있는데 왜 과학중학교는 없을까? 의아했던 적이 있습니다. 좀 더 세월이 흐른 후에 생각해보니 중학생 나이 때는 다양한 분야를 배우는 과정이 필요하겠다는 생각이 들었습니다. \" } ] } ] }, \"01D66BABF293CB0000000004\": { \"np\": \"01D66BABF293CB0000000005\", \"id\": -2147483648, \"pp\": \"01D66BABF294192000000019\", \"si\": \"01D66BABF29419200000001A\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D66BABF294192000000015\", \"ch\": [ { \"t\": \"\" } ] } ] }, \"01D66BABF293CB0000000005\": { \"np\": \"01D66BABF293CB0000000006\", \"id\": -2147483648, \"pp\": \"01D66BABF294192000000019\", \"si\": \"01D66BABF29419200000001A\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D66BABF294192000000015\", \"ch\": [ { \"t\": \"  선생님들은 어떠신가요? 저는 동시에 두 가지 일을 하지 못합니다. 가령 청소를 하면서 TV 시청이 어려워요. 전화 통화 중에 컴퓨터 화면을 보는 것도 마찬가지입니다. 어찌 보면 둘 다 단순한 과정인데도요. 중학교 과학 수업에 다양한 활동을 도입해야겠다고 생각한 이유 중에 한쪽으로 치우친 저의 성향도 한몫합니다. 학생들이 저의 부족한 점은 닮지 말았으면 좋겠거든요.^^\" } ] } ] }, \"01D66BABF293CB0000000006\": { \"np\": \"01D66BABF293CB0000000007\", \"id\": -2147483648, \"pp\": \"01D66BABF294192000000019\", \"si\": \"01D66BABF29419200000001A\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D66BABF294192000000015\", \"ch\": [ { \"t\": \"  \" } ] } ] }, \"01D66BABF293CB0000000007\": { \"np\": \"01D66BABF293CB0000000009\", \"id\": -2147483648, \"pp\": \"01D66BABF294192000000019\", \"si\": \"01D66BABF29419200000001A\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D66BABF294192000000015\", \"ch\": [ { \"t\": \"  어느 날 뉴스를 보다가 손준수 기자가 나왔고, 화면에 기자의 메일 주소가 떴습니다. \" } , { \"cc\": 3, \"ci\": 627600491, \"co\": \"01D66BABF293CB0000000002\" } ] } , { \"cp\": \"01D66BABF294192000000016\", \"ch\": [ { \"t\": \"handsome@kbs.co.kr\" } ] } , { \"cp\": \"01D66BABF294192000000015\", \"ch\": [ { \"cc\": 4, \"ci\": 6843499, \"co\": \"01D66BABF293CB0000000008\" } , { \"t\": \" \" } ] } ] }, \"01D66BABF293CB0000000009\": { \"np\": \"01D66BABF293CB000000000A\", \"id\": -2147483648, \"pp\": \"01D66BABF294192000000019\", \"si\": \"01D66BABF29419200000001A\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D66BABF294192000000015\", \"ch\": [ { \"t\": \"  순간 펑펑 쏟아지는 눈을 고스란히 맞으며 현장 소식을 전하여 유명해진 박대기 기자의 메일 주소(waiting)가 생각났습니다. 이때까지만 하더라도 KBS 기자들의 메일 주소가 특이한 줄 몰랐습니다. 우연한 기회에 인터넷에서 찾은 자료는 이렇습니다. \" } ] } ] }, \"01D66BABF293CB000000000A\": { \"np\": \"01D66BABF293CB000000000B\", \"id\": -2147483648, \"pp\": \"01D66BABF294192000000019\", \"si\": \"01D66BABF29419200000001A\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D66BABF294192000000015\", \"ch\": [ { \"t\": \"  김진화 evolution, 이효용 utility, 이규명 investigate, 안양봉 beebee, 신선민 freshmin, 김빛이라 glory, 정새배 newboat\" } ] } ] }, \"01D66BABF293CB000000000B\": { \"np\": \"01D66BABF293CB000000000C\", \"id\": -2147483648, \"pp\": \"01D66BABF294192000000019\", \"si\": \"01D66BABF29419200000001A\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D66BABF294192000000015\", \"ch\": [ { \"t\": \"  모두 기발하지만 그중 으뜸은 최선중 기자의 best-ing. ‘선중’이 왜 ‘best-ing’ 인지 순간 매치가 되지 않았습니다. ‘아! 최선을 다하는 중이라는 뜻이구나.’ 한 박자 늦게 이해했어요. -을 붙여서 더 기발하게 보이더군요. KBS 기자들은 선배들이 후배들의 메일 주소를 정해준다고 합니다. \" } ] } ] }, \"01D66BABF293CB000000000C\": { \"np\": \"01D66BABF293CB000000000D\", \"id\": -2147483648, \"pp\": \"01D66BABF294192000000019\", \"si\": \"01D66BABF29419200000001A\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D66BABF294192000000015\", \"ch\": [ { \"t\": \"  위 이야기를 충북대학교 화학교육과 한재영 교수님에게 전했더니, 교수님이 KBS 기자가 되었다면 메일 주소가 onetwozero 이었을 거라고 하시네요. 그렇다면 저는 goldenrain\" } ] } ] }, \"01D66BABF293CB000000000D\": { \"np\": \"01D66BABF293CB000000000E\", \"id\": -2147483648, \"pp\": \"01D66BABF294192000000019\", \"si\": \"01D66BABF29419200000001A\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D66BABF294192000000015\", \"ch\": [ { \"t\": \"\" } ] } ] }, \"01D66BABF293CB000000000E\": { \"np\": \"01D66BABF293CB000000000F\", \"id\": -2147483648, \"pp\": \"01D66BABF294192000000019\", \"si\": \"01D66BABF29419200000001A\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D66BABF294192000000015\", \"ch\": [ { \"t\": \"  몇 년 전 행성 여행 포스터 만들기 수업에서 언어유희를 필수 항목으로 채택한 적이 있습니다. 그 결과 자수성가(수성), 금성첨와(금성), 왕성왕성잘왕성(해왕성, 천왕성)…… 등이 나왔고 이후로는 거의 활용하지 않았습니다. \" } ] } ] }, \"01D66BABF293CB000000000F\": { \"np\": \"01D66BABF293CB0000000010\", \"id\": -2147483648, \"pp\": \"01D66BABF294192000000019\", \"si\": \"01D66BABF29419200000001A\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D66BABF294192000000015\", \"ch\": [ { \"t\": \"\" } ] } ] }, \"01D66BABF293CB0000000010\": { \"np\": \"01D66BABF293CB0000000011\", \"id\": -2147483648, \"pp\": \"01D66BABF294192000000019\", \"si\": \"01D66BABF29419200000001A\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D66BABF294192000000015\", \"ch\": [ { \"t\": \"  kbs 기자의 기발한 메일 주소를 보면서, 과학 수업에 언어유희를 적용하는 다양한 아이디어를 생각해보았지만 잘 떠오르지 않습니다. \" } ] } ] }, \"01D66BABF293CB0000000011\": { \"np\": \"01D66BABF293CB0000000012\", \"id\": -2147483648, \"pp\": \"01D66BABF294192000000019\", \"si\": \"01D66BABF29419200000001A\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D66BABF294192000000015\", \"ch\": [ { \"t\": \"\" } ] } ] }, \"01D66BABF293CB0000000012\": { \"np\": \"\", \"id\": -2147483648, \"pp\": \"01D66BABF294192000000019\", \"si\": \"01D66BABF29419200000001A\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D66BABF294192000000015\", \"ch\": [ { \"t\": \"  버르장머리(?) 없는 코로나가 속히 물러가서 모둠 수업이 자유로워지기를 기대해 봅니다. \" } ] } ] } }, \"sl\": { }, \"cs\": { \"01D66BABF293CB0000000000\": { \"cc\": 2, \"ci\": 1936024420, \"td\": 0, \"tv\": false, \"sc\": 1134, \"ts\": 8000, \"ms\": \"\", \"os\": \"\", \"gl\": 0, \"gc\": 0, \"gw\": false, \"ns\": 0, \"np\": 0, \"ni\": 0, \"nt\": 0, \"ne\": 0, \"hh\": false, \"hf\": false, \"hm\": false, \"fb\": false, \"hb\": false, \"fi\": false, \"hi\": false, \"hp\": false, \"h