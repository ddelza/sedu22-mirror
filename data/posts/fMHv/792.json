  "contentHtml": "<div class=\"figure-html\" data-ke-type=\"html\" data-source=\"&lt;div class=&quot;txc-textbox&quot; style=&quot;padding: 10px; border: 3px double rgb(254, 137, 67); border-image: none; background-color: rgb(254, 222, 199);&quot;&gt;\n&lt;p style=&quot;text-align: center; line-height: 19.2px;&quot;&gt;&lt;/p&gt;\n&lt;figure data-ke-type=&quot;image&quot; data-ke-style=&quot;alignCenter&quot; data-img-src=&quot;https://t1.daumcdn.net/cfile/cafe/2177E44357EA330A27&quot; data-origin-width=&quot;0&quot; data-origin-height=&quot;0&quot; data-ke-mobilestyle=&quot;widthOrigin&quot; data-link=&quot;&quot; data-link-islinknewwindow=&quot;false&quot;&gt;&lt;img src=&quot;https://t1.daumcdn.net/cfile/cafe/2177E44357EA330A27&quot; class=&quot;txc-image&quot; width=&quot;1024&quot; style=&quot;clear: none; float: none;&quot; border=&quot;0&quot; vspace=&quot;1&quot; hspace=&quot;1&quot; actualwidth=&quot;1024&quot; exif=&quot;{}&quot; data-filename=&quot;물의 분포1.jpg&quot; id=&quot;A_2177E44357EA330A271255&quot;&gt;&lt;/figure&gt;\n&lt;p style=&quot;text-align: center; line-height: 19.2px;&quot;&gt;&lt;/p&gt;\n&lt;figure data-ke-type=&quot;image&quot; data-ke-style=&quot;alignCenter&quot; data-img-src=&quot;https://t1.daumcdn.net/cfile/cafe/2555AD4557EA331B17&quot; data-origin-width=&quot;0&quot; data-origin-height=&quot;0&quot; data-ke-mobilestyle=&quot;widthOrigin&quot; data-link=&quot;&quot; data-link-islinknewwindow=&quot;false&quot;&gt;&lt;img src=&quot;https://t1.daumcdn.net/cfile/cafe/2555AD4557EA331B17&quot; class=&quot;txc-image&quot; width=&quot;1024&quot; style=&quot;clear: none; float: none;&quot; border=&quot;0&quot; vspace=&quot;1&quot; hspace=&quot;1&quot; actualwidth=&quot;1024&quot; exif=&quot;{}&quot; data-filename=&quot;물의 분포2.jpg&quot; id=&quot;A_2555AD4557EA331B173150&quot;&gt;&lt;/figure&gt;\n&lt;p style=&quot;text-align: center; line-height: 19.2px;&quot;&gt;&lt;/p&gt;\n&lt;figure data-ke-type=&quot;image&quot; data-ke-style=&quot;alignCenter&quot; data-img-src=&quot;https://t1.daumcdn.net/cfile/cafe/2253784557EA332E1A&quot; data-origin-width=&quot;0&quot; data-origin-height=&quot;0&quot; data-ke-mobilestyle=&quot;widthOrigin&quot; data-link=&quot;&quot; data-link-islinknewwindow=&quot;false&quot;&gt;&lt;img src=&quot;https://t1.daumcdn.net/cfile/cafe/2253784557EA332E1A&quot; class=&quot;txc-image&quot; width=&quot;1024&quot; style=&quot;clear: none; float: none;&quot; border=&quot;0&quot; vspace=&quot;1&quot; hspace=&quot;1&quot; actualwidth=&quot;1024&quot; exif=&quot;{}&quot; data-filename=&quot;물의 특징1.jpg&quot; id=&quot;A_2253784557EA332E1A59EB&quot;&gt;&lt;/figure&gt;\n&lt;p style=&quot;text-align: center; line-height: 19.2px;&quot;&gt;&lt;/p&gt;\n&lt;figure data-ke-type=&quot;image&quot; data-ke-style=&quot;alignCenter&quot; data-img-src=&quot;https://t1.daumcdn.net/cfile/cafe/266B7C4257EA334030&quot; data-origin-width=&quot;0&quot; data-origin-height=&quot;0&quot; data-ke-mobilestyle=&quot;widthOrigin&quot; data-link=&quot;&quot; data-link-islinknewwindow=&quot;false&quot;&gt;&lt;img src=&quot;https://t1.daumcdn.net/cfile/cafe/266B7C4257EA334030&quot; class=&quot;txc-image&quot; width=&quot;1024&quot; style=&quot;clear: none; float: none;&quot; border=&quot;0&quot; vspace=&quot;1&quot; hspace=&quot;1&quot; actualwidth=&quot;1024&quot; exif=&quot;{}&quot; data-filename=&quot;물의 특징2.jpg&quot; id=&quot;A_266B7C4257EA334030267C&quot;&gt;&lt;/figure&gt;\n&lt;p style=&quot;text-align: center; line-height: 19.2px;&quot;&gt;&lt;/p&gt;\n&lt;figure data-ke-type=&quot;image&quot; data-ke-style=&quot;alignCenter&quot; data-img-src=&quot;https://t1.daumcdn.net/cfile/cafe/24689F4257EA335C34&quot; data-origin-width=&quot;0&quot; data-origin-height=&quot;0&quot; data-ke-mobilestyle=&quot;widthOrigin&quot; data-link=&quot;&quot; data-link-islinknewwindow=&quot;false&quot;&gt;&lt;img src=&quot;https://t1.daumcdn.net/cfile/cafe/24689F4257EA335C34&quot; class=&quot;txc-image&quot; width=&quot;1024&quot; style=&quot;clear: none; float: none;&quot; border=&quot;0&quot; vspace=&quot;1&quot; hspace=&quot;1&quot; actualwidth=&quot;1024&quot; exif=&quot;{}&quot; data-filename=&quot;물의 특징3.jpg&quot; id=&quot;A_24689F4257EA335C34F2FF&quot;&gt;&lt;/figure&gt;\n&lt;p style=&quot;text-align: center; line-height: 19.2px;&quot;&gt;&lt;/p&gt;\n&lt;figure data-ke-type=&quot;image&quot; data-ke-style=&quot;alignCenter&quot; data-img-src=&quot;https://t1.daumcdn.net/cfile/cafe/2568523E57EA336F03&quot; data-origin-width=&quot;0&quot; data-origin-height=&quot;0&quot; data-ke-mobilestyle=&quot;widthOrigin&quot; data-link=&quot;&quot; data-link-islinknewwindow=&quot;false&quot;&gt;&lt;img src=&quot;https://t1.daumcdn.net/cfile/cafe/2568523E57EA336F03&quot; class=&quot;txc-image&quot; width=&quot;1024&quot; style=&quot;clear: none; float: none;&quot; border=&quot;0&quot; vspace=&quot;1&quot; hspace=&quot;1&quot; actualwidth=&quot;1024&quot; exif=&quot;{}&quot; data-filename=&quot;소중한 수자원1.jpg&quot; id=&quot;A_2568523E57EA336F033551&quot;&gt;&lt;/figure&gt;\n&lt;p style=&quot;text-align: center; line-height: 19.2px;&quot;&gt;&lt;span style=&quot;font-size: 12pt&quot; data-ke-size=&quot;size18&quot;&gt;&lt;span style=&quot;line-height: 25.6px; font-size: 11pt;&quot; data-ke-size=&quot;size18&quot;&gt;&amp;lt;재미있는 과학수업 만들기&amp;gt;의 수업관련자료들은 선생님들의 '협업'을 위해 공유되고 있습니다.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;\n&lt;p style=&quot;text-align: center; line-height: 19.2px;&quot;&gt;&lt;span style=&quot;font-size: 12pt&quot; data-ke-size=&quot;size18&quot;&gt;&lt;span style=&quot;line-height: 25.6px; font-size: 11pt;&quot; data-ke-size=&quot;size18&quot;&gt;수업을 위한 자료로만 사용해주시기 바랍니다.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;\n&lt;p style=&quot;text-align: center; line-height: 19.2px;&quot;&gt;&lt;b&gt;&lt;span style=&quot;line-height: 1.6; font-size: 11pt;&quot; data-ke-size=&quot;size18&quot;&gt;** '말머리' 에서 해당단원을 선택해주세요.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;line-height: 1.6; font-size: 18pt;&quot; data-ke-size=&quot;size23&quot;&gt;&lt;span style=&quot;font-size: 11pt;&quot; data-ke-size=&quot;size18&quot;&gt;수업자료를 찾기 쉬워집니다.**&lt;/span&gt;&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;!--StartFragment--&gt;&lt;/p&gt;&lt;/div&gt;\"><div data-ke-class=\"article\"><div class=\"txc-textbox\" style=\"padding: 10px; border: 3px double rgb(254, 137, 67); border-image: none; background-color: rgb(254, 222, 199);\">\n<p style=\"text-align: center; line-height: 19.2px;\"></p>\n<figure data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-img-src=\"https://t1.daumcdn.net/cfile/cafe/2177E44357EA330A27\" data-origin-width=\"0\" data-origin-height=\"0\" data-ke-mobilestyle=\"widthOrigin\" data-link=\"\" data-link-islinknewwindow=\"false\"><img src=\"https://t1.daumcdn.net/cfile/cafe/2177E44357EA330A27\" class=\"txc-image\" width=\"1024\" style=\"clear: none; float: none;\" border=\"0\" vspace=\"1\" hspace=\"1\" actualwidth=\"1024\" exif=\"{}\" data-filename=\"물의 분포1.jpg\" id=\"A_2177E44357EA330A271255\"></figure>\n<p style=\"text-align: center; line-height: 19.2px;\"></p>\n<figure data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-img-src=\"https://t1.daumcdn.net/cfile/cafe/2555AD4557EA331B17\" data-origin-width=\"0\" data-origin-height=\"0\" data-ke-mobilestyle=\"widthOrigin\" data-link=\"\" data-link-islinknewwindow=\"false\"><img src=\"https://t1.daumcdn.net/cfile/cafe/2555AD4557EA331B17\" class=\"txc-image\" width=\"1024\" style=\"clear: none; float: none;\" border=\"0\" vspace=\"1\" hspace=\"1\" actualwidth=\"1024\" exif=\"{}\" data-filename=\"물의 분포2.jpg\" id=\"A_2555AD4557EA331B173150\"></figure>\n<p style=\"text-align: center; line-height: 19.2px;\"></p>\n<figure data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-img-src=\"https://t1.daumcdn.net/cfile/cafe/2253784557EA332E1A\" data-origin-width=\"0\" data-origin-height=\"0\" data-ke-mobilestyle=\"widthOrigin\" data-link=\"\" data-link-islinknewwindow=\"false\"><img src=\"https://t1.daumcdn.net/cfile/cafe/2253784557EA332E1A\" class=\"txc-image\" width=\"1024\" style=\"clear: none; float: none;\" border=\"0\" vspace=\"1\" hspace=\"1\" actualwidth=\"1024\" exif=\"{}\" data-filename=\"물의 특징1.jpg\" id=\"A_2253784557EA332E1A59EB\"></figure>\n<p style=\"text-align: center; line-height: 19.2px;\"></p>\n<figure data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-img-src=\"https://t1.daumcdn.net/cfile/cafe/266B7C4257EA334030\" data-origin-width=\"0\" data-origin-height=\"0\" data-ke-mobilestyle=\"widthOrigin\" data-link=\"\" data-link-islinknewwindow=\"false\"><img src=\"https://t1.daumcdn.net/cfile/cafe/266B7C4257EA334030\" class=\"txc-image\" width=\"1024\" style=\"clear: none; float: none;\" border=\"0\" vspace=\"1\" hspace=\"1\" actualwidth=\"1024\" exif=\"{}\" data-filename=\"물의 특징2.jpg\" id=\"A_266B7C4257EA334030267C\"></figure>\n<p style=\"text-align: center; line-height: 19.2px;\"></p>\n<figure data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-img-src=\"https://t1.daumcdn.net/cfile/cafe/24689F4257EA335C34\" data-origin-width=\"0\" data-origin-height=\"0\" data-ke-mobilestyle=\"widthOrigin\" data-link=\"\" data-link-islinknewwindow=\"false\"><img src=\"https://t1.daumcdn.net/cfile/cafe/24689F4257EA335C34\" class=\"txc-image\" width=\"1024\" style=\"clear: none; float: none;\" border=\"0\" vspace=\"1\" hspace=\"1\" actualwidth=\"1024\" exif=\"{}\" data-filename=\"물의 특징3.jpg\" id=\"A_24689F4257EA335C34F2FF\"></figure>\n<p style=\"text-align: center; line-height: 19.2px;\"></p>\n<figure data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-img-src=\"https://t1.daumcdn.net/cfile/cafe/2568523E57EA336F03\" data-origin-width=\"0\" data-origin-height=\"0\" data-ke-mobilestyle=\"widthOrigin\" data-link=\"\" data-link-islinknewwindow=\"false\"><img src=\"https://t1.daumcdn.net/cfile/cafe/2568523E57EA336F03\" class=\"txc-image\" width=\"1024\" style=\"clear: none; float: none;\" border=\"0\" vspace=\"1\" hspace=\"1\" actualwidth=\"1024\" exif=\"{}\" data-filename=\"소중한 수자원1.jpg\" id=\"A_2568523E57EA336F033551\"></figure>\n<p style=\"text-align: center; line-height: 19.2px;\"><span style=\"font-size: 12pt\" data-ke-size=\"size18\"><span style=\"line-height: 25.6px; font-size: 11pt;\" data-ke-size=\"size18\">&lt;재미있는 과학수업 만들기&gt;의 수업관련자료들은 선생님들의 '협업'을 위해 공유되고 있습니다.</span></span></p>\n<p style=\"text-align: center; line-height: 19.2px;\"><span style=\"font-size: 12pt\" data-ke-size=\"size18\"><span style=\"line-height: 25.6px; font-size: 11pt;\" data-ke-size=\"size18\">수업을 위한 자료로만 사용해주시기 바랍니다.&nbsp;</span></span></p>\n<p style=\"text-align: center; line-height: 19.2px;\"><b><span style=\"line-height: 1.6; font-size: 11pt;\" data-ke-size=\"size18\">** '말머리' 에서 해당단원을 선택해주세요.&nbsp;</span><span style=\"line-height: 1.6; font-size: 18pt;\" data-ke-size=\"size23\"><span style=\"font-size: 11pt;\" data-ke-size=\"size18\">수업자료를 찾기 쉬워집니다.**</span></span></b><br><!--StartFragment--></p></div></div></div><p><span data-ke-size=\"size18\">자유학기제</span><span data-ke-size=\"size18\">, </span><span data-ke-size=\"size18\">참 좋습니다</span><span data-ke-size=\"size18\">. ^^</span></p><p>&#160;</p><p><span data-ke-size=\"size18\">개학하면서 자유학기제가 시작되었을 때 더위에 지친 학생들을 위해 </span><span data-ke-size=\"size18\">7</span><span data-ke-size=\"size18\">단원을 먼저 시작하였습니다</span><span data-ke-size=\"size18\">. </span><span data-ke-size=\"size18\">자유학기제가 되면서 시수가 </span><span data-ke-size=\"size18\">2</span><span data-ke-size=\"size18\">시간으로 줄었기 때문에 진도문제도 고려해야 하는 상황이었지요</span><span data-ke-size=\"size18\">.</span></p><p>&#160;</p><p><span data-ke-size=\"size18\">7-1</span><span data-ke-size=\"size18\">단원은 이렇게 재구성하였습니다</span><span data-ke-size=\"size18\">. </span></p><p><span data-ke-size=\"size18\">물의 분포 </span><span data-ke-size=\"size18\">: </span><span data-ke-size=\"size18\">교과서에 나오는 익숙한 원형도표를 창의적으로 재구성하여 표현하기</span><span data-ke-size=\"size18\">, </span><span data-ke-size=\"size18\">물의 특징을 조사하고 알기 쉽게 표현하기</span><span data-ke-size=\"size18\">, </span><span data-ke-size=\"size18\">소중한 수자원을 주제로 포스터 그리기 </span></p><p>&#160;</p><p><span data-ke-size=\"size18\">총 </span><span data-ke-size=\"size18\">6</span><span data-ke-size=\"size18\">모둠이므로 하나의 주제를 두 개의 모둠이 선택하였고요</span><span data-ke-size=\"size18\">. </span><span data-ke-size=\"size18\">모둠활동이 끝난 후에 발표시간을 가졌습니다</span><span data-ke-size=\"size18\">. </span><span data-ke-size=\"size18\">모든 결과물은 과학실과 과학실 복도의 게시판에 붙여두었습니다</span><span data-ke-size=\"size18\">.(</span><span data-ke-size=\"size18\">첨부파일</span><span data-ke-size=\"size18\">)</span></p><p>&#160;</p><p><span data-ke-size=\"size18\">빙하수업은 아래 </span><span data-ke-size=\"size18\">36</span><span data-ke-size=\"size18\">번방에 있는 </span><span data-ke-size=\"size18\">&lt;</span><span data-ke-size=\"size18\">최대한 얼음을 녹지 않게 하는 방법</span><span data-ke-size=\"size18\">&gt;</span><span data-ke-size=\"size18\">을 병행하였습니다</span><span data-ke-size=\"size18\">.</span></p><p>&#160;</p><p><span data-ke-size=\"size18\">7-2</span><span data-ke-size=\"size18\">단원 </span><span data-ke-size=\"size18\">&lt;</span><span data-ke-size=\"size18\">깊이에 따른 소금물의 수온변화</span><span data-ke-size=\"size18\">&gt;</span><span data-ke-size=\"size18\">는 올해 처음 해 본 실험입니다. </span><span data-ke-size=\"size18\">단</span><span data-ke-size=\"size18\">, </span><span data-ke-size=\"size18\">교과서 그림처럼 전등 하나로는 온도변화가 잘 포착되지 않아 두 개의 전등을 사용하였습니다</span><span data-ke-size=\"size18\">.</span></p><p>&#160;</p><p><span data-ke-size=\"size18\">7-3</span><span data-ke-size=\"size18\">단원은 표층해류</span><span data-ke-size=\"size18\">, </span><span data-ke-size=\"size18\">심층해류 실험을 먼저 하였고요</span><span data-ke-size=\"size18\">. </span><span data-ke-size=\"size18\">마지막 부분인 해양 자원과 해양환경 오염은 </span><span data-ke-size=\"size18\">&lt;</span><span data-ke-size=\"size18\">내가 해양수산부 장관이 된다면</span><span data-ke-size=\"size18\">?&gt;</span><span data-ke-size=\"size18\">으로 설정하였습니다</span><span data-ke-size=\"size18\">.‘</span><span data-ke-size=\"size18\">미래의 어느 날 내가 해사부 장관이 되어 청문회를 앞두고 있다</span><span data-ke-size=\"size18\">. </span><span data-ke-size=\"size18\">참모들</span><span data-ke-size=\"size18\">(</span><span data-ke-size=\"size18\">모둠의 친구들</span><span data-ke-size=\"size18\">)</span><span data-ke-size=\"size18\">과 함께 역할 분담을 하여 해양자원에 대한 자료를 만들고 발표하기</span><span data-ke-size=\"size18\">’</span><span data-ke-size=\"size18\">입니다</span><span data-ke-size=\"size18\">.</span></p><p style=\"text-align: center;\">&#160;</p><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/83ca2d909f3f045d0c4fb2e69a8d6b684a6eb5e1\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/83ca2d909f3f045d0c4fb2e69a8d6b684a6eb5e1\" data-origin-width=\"1024\" data-origin-height=\"576\"></div><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/87fdcc97fb76bf1700110862ceaed2fe7b4ede15\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/87fdcc97fb76bf1700110862ceaed2fe7b4ede15\" data-origin-width=\"1024\" data-origin-height=\"1820\"></div><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/118136557adcfa330f796753dbb784b00114d61a\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/118136557adcfa330f796753dbb784b00114d61a\" data-origin-width=\"1024\" data-origin-height=\"1820\"></div><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/41ee99e150c75bc63af0aa38ee0ab09b306226fd\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/41ee99e150c75bc63af0aa38ee0ab09b306226fd\" data-origin-width=\"1024\" data-origin-height=\"576\"></div><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/0836ec2619d00150f2269e2bdafe8147dc339fd3\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/0836ec2619d00150f2269e2bdafe8147dc339fd3\" data-origin-width=\"1024\" data-origin-height=\"1820\"></div><p>&#160;</p><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/7227791f2c90223e6070e34b93b1bfd5d9c9fc1c\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/7227791f2c90223e6070e34b93b1bfd5d9c9fc1c\" data-origin-width=\"1024\" data-origin-height=\"576\"></div><p>&#160;</p><p style=\"text-align: center;\">&#160;</p><p>&#160;</p><p style=\"text-align: center;\">&#160;</p><p>&#160;</p><p style=\"text-align: center;\">&#160;</p><p>&#160;</p><p style=\"text-align: center;\">&#160;</p><p>&#160;</p>\n\t \t\t\t\t\t<!-- -->"
}