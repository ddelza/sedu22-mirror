  "contentHtml": "<!--StartFragment--><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; FONT-WEIGHT: bold; mso-font-width: 100%; mso-text-raise: 0pt\" >(</SPAN><SPAN style=\"BACKGROUND: #ffffff; FONT-WEIGHT: bold; mso-fareast-font-family: 함초롬바탕\">광물 마지막 시간에는</SPAN><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; FONT-WEIGHT: bold; mso-font-width: 100%; mso-text-raise: 0pt\" >)</SPAN></P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">운동장에 나가서 광물들을 찾고</SPAN></P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">어떤 광물인지 광물표본</SPAN><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; mso-font-width: 100%; mso-text-raise: 0pt\" >, </SPAN><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">모스 굳기계</SPAN><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; mso-font-width: 100%; mso-text-raise: 0pt\" >, </SPAN><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">교과서 등을 이용하여 </SPAN></P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">찾아봅니다</SPAN><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; mso-font-width: 100%; mso-text-raise: 0pt\" >.</SPAN></P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0></P></SPAN>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\"></SPAN>&nbsp;</P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\"></SPAN>&nbsp;</P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\"><STRONG><SPAN style=\"FONT-SIZE: 11pt\">(암석수업)</SPAN></STRONG></SPAN></P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">화성암 </SPAN><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; mso-font-width: 100%; mso-text-raise: 0pt\" >: </SPAN><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">화강암</SPAN><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; mso-font-width: 100%; mso-text-raise: 0pt\" >, </SPAN><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">현무암</SPAN></P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">퇴적암 </SPAN><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; mso-font-width: 100%; mso-text-raise: 0pt\" >: </SPAN><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">셰일</SPAN><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; mso-font-width: 100%; mso-text-raise: 0pt\" >, </SPAN><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">사암</SPAN><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; mso-font-width: 100%; mso-text-raise: 0pt\" >, </SPAN><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">역암</SPAN></P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">변성암 </SPAN><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; mso-font-width: 100%; mso-text-raise: 0pt\" >: </SPAN><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">대리암</SPAN><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; mso-font-width: 100%; mso-text-raise: 0pt\" >, </SPAN><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">편암</SPAN><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; mso-font-width: 100%; mso-text-raise: 0pt\" >, </SPAN><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">편마암</SPAN></P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0>&nbsp; </P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; mso-font-width: 100%; mso-text-raise: 0pt\" >1. </SPAN><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">화성암에 </SPAN><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; mso-font-width: 100%; mso-text-raise: 0pt\" >A, B </SPAN><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">스티커를 붙이고</SPAN></P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff\" ></SPAN><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">어떤 곳에서 생성되었는지 추론해보기</SPAN></P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0>&nbsp; </P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; mso-font-width: 100%; mso-text-raise: 0pt\" >2. </SPAN><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">퇴적암에 </SPAN><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; mso-font-width: 100%; mso-text-raise: 0pt\" >A, B, C </SPAN><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">스티커를 붙이고</SPAN></P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">어떤 곳에서 생성되었는지 추론해보기</SPAN></P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0>&nbsp; </P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; mso-font-width: 100%; mso-text-raise: 0pt\" >3. </SPAN><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">변성암에 </SPAN><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; mso-font-width: 100%; mso-text-raise: 0pt\" >A, B, C </SPAN><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">스티커를 붙이고</SPAN></P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">어떻게 생성되었는지 추론해보기</SPAN></P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; mso-font-width: 100%; mso-text-raise: 0pt\" >(</SPAN><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">편리 등을 보면 뭔가 압력을 받았다는 것을 예측</SPAN><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; mso-font-width: 100%; mso-text-raise: 0pt\" >)</SPAN></P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0>&nbsp; </P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">이렇게 진행하구요</SPAN><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; mso-font-width: 100%; mso-text-raise: 0pt\" >.</SPAN></P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0>&nbsp; </P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0>&nbsp; </P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">그리고 활동이 모두 끝나면</SPAN></P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">각각의 암석의 명칭을 책에서 찾아보고 </SPAN></P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0><SPAN style=\"BACKGROUND: #ffffff; mso-fareast-font-family: 함초롬바탕\">암석에 대한 내용을 정리합니다</SPAN><SPAN style=\"LETTER-SPACING: 0pt; FONT-FAMILY: 함초롬바탕; BACKGROUND: #ffffff; mso-font-width: 100%; mso-text-raise: 0pt\" >.</SPAN></P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0>&nbsp; </P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0>&nbsp;</P>\r\n<P style=\"BACKGROUND: #ffffff; TEXT-AUTOSPACE: ; mso-pagination: none; mso-padding-alt: 0pt 0pt 0pt 0pt\" class=0>&nbsp;* 선생님들의 생각은 어떠신지요?</P>\n\t \t\t\t\t\t<!-- -->"
}