i\": false } }, \"st\": { \"01D578D5708306E000000022\": { \"id\": 0, \"ty\": 0, \"na\": \"바탕글\", \"en\": \"Normal\", \"pp\": \"01D578D5708306E000000021\", \"cp\": \"01D578D5708306E00000001D\", \"ns\": \"01D578D5708306E000000022\", \"li\": 1042, \"lf\": false } }, \"mp\": { }, \"ro\": { \"hp\": \"01D578D5708306E000000002\", \"01D578D5708306E000000002\": { \"np\": \"01D578D5708306E000000003\", \"id\": 0, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 3, \"ru\": [ { \"cp\": \"01D578D5708306E00000001C\", \"ch\": [ { \"cc\": 2, \"ci\": 1936024420, \"co\": \"01D578D5708306E000000000\" } , { \"cc\": 2, \"ci\": 1668246628, \"co\": \"01D578D5708306E000000001\" } , { \"t\": \"해수의 연직 수온 분포 실험을 하였습니다.\" } ] } ] }, \"01D578D5708306E000000003\": { \"np\": \"01D578D5708306E000000004\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001C\", \"ch\": [ { \"t\": \"\" } ] } ] }, \"01D578D5708306E000000004\": { \"np\": \"01D578D5708306E000000005\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001C\", \"ch\": [ { \"t\": \"2009 교육과정 때 샀던 장치를 사용하였고요. \" } ] } ] }, \"01D578D5708306E000000005\": { \"np\": \"01D578D5708306E000000006\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001C\", \"ch\": [ { \"t\": \"\" } ] } ] }, \"01D578D5708306E000000006\": { \"np\": \"01D578D5708306E000000007\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001C\", \"ch\": [ { \"t\": \"교과서 장치와 두 가지가 다릅니다. 적외선 등이 아닌 백열전등을 비추었고, 온도계를 수조 둘레에 설치한 점입니다. 수조의 중앙에 설치하려고 해도 온도계 고정 장치가 테두리에 맞게 만들어져 이런저런 도구를 사용해 보았지만 그렇게 할 수 없었습니다.\" } ] } ] }, \"01D578D5708306E000000007\": { \"np\": \"01D578D5708306E000000008\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001C\", \"ch\": [ { \"t\": \"\" } ] } ] }, \"01D578D5708306E000000008\": { \"np\": \"01D578D5708306E000000009\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001C\", \"ch\": [ { \"t\": \"원래의 장치에 포함된 백열전등으로는 온도의 변화가 미약하고, 고정 장치에 넣은 온도계의 구부가 수조의 벽에 닿아 수온을 측정하는 목적과 맞지 않은 점이 문제였습니다. 적외선 등을 추가로 구입하려 했으나 과학 교재상에서 고온으로 인한 문제가 발생할 소지가 있다고 하여 별도로 마련하지 않았습니다. \" } ] } ] }, \"01D578D5708306E000000009\": { \"np\": \"01D578D5708306E00000000A\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001C\", \"ch\": [ { \"t\": \"\" } ] } ] }, \"01D578D5708306E00000000A\": { \"np\": \"01D578D5708306E00000000B\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001C\", \"ch\": [ { \"t\": \"문제점을 해결하려고 이렇게 하였습니다. \" } ] } ] }, \"01D578D5708306E00000000B\": { \"np\": \"01D578D5708306E00000000C\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001C\", \"ch\": [ { \"t\": \"1. 수온을 높이기 위해 장치에 포함된 전구에다 백열전등 하나씩 추가\" } ] } ] }, \"01D578D5708306E00000000C\": { \"np\": \"01D578D5708306E00000000D\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001C\", \"ch\": [ { \"t\": \"2. 온도계가 수조의 벽에 닿는 문제는 스타이로폼 조각을 수조와 온도계 사이에 끼워 공간 만들기\" } ] } ] }, \"01D578D5708306E00000000D\": { \"np\": \"01D578D5708306E00000000E\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001C\", \"ch\": [ { \"t\": \"\" } ] } ] }, \"01D578D5708306E00000000E\": { \"np\": \"01D578D5708306E00000000F\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001C\", \"ch\": [ { \"t\": \"온도계 자체의 오차가 있어 처음 온도가 일정하지 않습니다. 학생들에게 처음 온도에서 얼마나 변하였는지가 중요하다고 강조하면서, 소수 첫째 자리까지 정밀하게 측정해야만 1도 이하의 온도변화도 의미를 부여할 수 있다고 하였습니다. 이번 실험이 아니더라도 1/10 눈금까지 측정하는 것이 맞으니까요.\" } ] } ] }, \"01D578D5708306E00000000F\": { \"np\": \"01D578D5708306E000000010\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001C\", \"ch\": [ { \"t\": \"\" } ] } ] }, \"01D578D5708306E000000010\": { \"np\": \"01D578D5708306E000000011\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001C\", \"ch\": [ { \"t\": \"아직 학생들의 보고서를 아직 다 검토하지는 않았고, 손에 잡히는 대로 두 명의 결과를 올리면 아래와 같습니다. \" } ] } ] }, \"01D578D5708306E000000011\": { \"np\": \"01D578D5708306E000000012\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001C\", \"ch\": [ { \"t\": \"\" } ] } ] }, \"01D578D5708306E000000012\": { \"np\": \"01D578D5708306E000000013\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001C\", \"ch\": [ { \"t\": \"이번 실험을 통해 학생들은 온도 1도가 올라간다는 의미를 제대로 파악했다고 믿습니다. 실험 결과를 분석(수면 부근의 온도변화가 가장 크다. 선풍기로 바람을 일으키면 수면 부근의 온도가 백열전등을 비추었을 때 보다 내려간다. A, B 층의 온도가 일정한 모둠이 있으면 크게 칭찬하고 실제 바다의 경우를 예로 들어 설명)하고 난 후 그래프 그리기는 우리 학교와 다른 교과서 출판사에서 제시한 값을 대입하려고 해요. 그 값이 그래프 그리기에 최적이어서 선택하였습니다. \" } ] } ] }, \"01D578D5708306E000000013\": { \"np\": \"01D578D5708306E000000014\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001C\", \"ch\": [ { \"t\": \"\" } ] } ] }, \"01D578D5708306E000000014\": { \"np\": \"01D578D5708306E000000015\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001C\", \"ch\": [ { \"t\": \"2학년 친구들! 덥고 습한 날씨에 최선을 다하였습니다. 손 선풍기는 워낙 많이 가지고 다니는 물건이라 학교에서 준비하지 않았다고 했는데, 탁상형 대형(?) 선풍기까지 가지고 오는 열의를 보였습니다.\" } ] } ] }, \"01D578D5708306E000000015\": { \"np\": \"01D578D5708306E000000016\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001C\", \"ch\": [ { \"t\": \"\" } ] } ] }, \"01D578D5708306E000000016\": { \"np\": \"01D578D5708306E000000017\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001C\", \"ch\": [ { \"t\": \"이 실험을 해 보신 선생님들 팁을 부탁드립니다. 적외선 등을 사용한 결과가 궁금하고요. 의미 있는 온도변화가 나왔다면 방법을 알려주세요.\" } ] } ] }, \"01D578D5708306E000000017\": { \"np\": \"01D578D5708306E000000018\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000021\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001D\", \"ch\": [ { \"t\": \"\" } ] } ] }, \"01D578D5708306E000000018\": { \"np\": \"\", \"id\": -2147483648, \"pp\": \"01D578D5708306E000000020\", \"si\": \"01D578D5708306E000000022\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D578D5708306E00000001B\", \"ch\": [ { \"t\": \"\" } ] } ] } }, \"sl\": { }, \"cs\": { \"01D578D5708306E000000000\": { \"cc\": 2, \"ci\": 1936024420, \"td\": 0, \"tv\": false, \"sc\": 1134, \"ts\": 8000, \"ms\": \"\", \"os\": \"01D578D5708306E00000001F\", \"gl\": 0, \"gc\": 0, \"gw\": false, \"ns\": 0, \"np\": 0, \"ni\": 0, \"nt\": 0, \"ne\": 0, \"hh\": false, \"hf\": false, \"hm\": false, \"fb\": false, \"hb\": false, \"fi\": false, 