1C4C0C900000000A\": { \"np\": \"01D5A4071C4C0C900000000B\", \"id\": -2147483648, \"pp\": \"01D5A4071C4C33A00000001E\", \"si\": \"01D5A4071C4C33A00000001F\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D5A4071C4C0C900000001A\", \"ch\": [ { \"t\": \"\" } ] } ] }, \"01D5A4071C4C0C900000000B\": { \"np\": \"01D5A4071C4C0C900000000C\", \"id\": -2147483648, \"pp\": \"01D5A4071C4C33A00000001E\", \"si\": \"01D5A4071C4C33A00000001F\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D5A4071C4C0C900000001A\", \"ch\": [ { \"t\": \"이번 학교에서는 사과로만 작품을 만들었습니다. 요즘 학생들이 과도를 사용해본 경험이 거의 없더군요. 안전문제가 염려되어 손에 익은 집 과도를 가져오라고 미리 알렸습니다. \" } ] } ] }, \"01D5A4071C4C0C900000000C\": { \"np\": \"01D5A4071C4C0C900000000D\", \"id\": -2147483648, \"pp\": \"01D5A4071C4C33A00000001E\", \"si\": \"01D5A4071C4C33A00000001F\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D5A4071C4C0C900000001A\", \"ch\": [ { \"t\": \"\" } ] } ] }, \"01D5A4071C4C0C900000000D\": { \"np\": \"01D5A4071C4C0C900000000E\", \"id\": -2147483648, \"pp\": \"01D5A4071C4C33A00000001E\", \"si\": \"01D5A4071C4C33A00000001F\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D5A4071C4C0C900000001A\", \"ch\": [ { \"t\": \"제가 준비한 것은 특상품 사과를 주문하여 깨끗이 씻고\" } ] } ] }, \"01D5A4071C4C0C900000000E\": { \"np\": \"01D5A4071C4C0C900000000F\", \"id\": -2147483648, \"pp\": \"01D5A4071C4C33A00000001E\", \"si\": \"01D5A4071C4C33A00000001F\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D5A4071C4C0C900000001A\", \"ch\": [ { \"t\": \"\" } ] } ] }, \"01D5A4071C4C0C900000000F\": { \"np\": \"01D5A4071C4C0C9000000010\", \"id\": -2147483648, \"pp\": \"01D5A4071C4C33A00000001E\", \"si\": \"01D5A4071C4C33A00000001F\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D5A4071C4C0C900000001A\", \"ch\": [ { \"t\": \"접시와 도마를 팔팔 끓는 물에 소독하였습니다. 학생들이 가져온 과도도 끓는 물에 넣었습니다.\" } ] } ] }, \"01D5A4071C4C0C9000000010\": { \"np\": \"01D5A4071C4C0C9000000011\", \"id\": -2147483648, \"pp\": \"01D5A4071C4C33A00000001E\", \"si\": \"01D5A4071C4C33A00000001F\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D5A4071C4C0C900000001A\", \"ch\": [ { \"t\": \"\" } ] }