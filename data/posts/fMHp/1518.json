.daumcdn.net/cafeattach/1TaBA/d1dbb2fc1dd2b9316dce6ad4b7c863e2883b8138?download\" data-file-name=\"실험분석앱.html\" data-file-size=\"18324\" data-mimetype=\"text/html\" data-ke-align=\"alignCenter\"><a href=\"javascript:checkVirus('grpid%3D1TaBA%26fldid%3DfMHp%26dataid%3D1518%26fileid%3D28%26regdt%3D20260607061945&url=https%3A%2F%2Ft1.daumcdn.net%2Fcafeattach%2F1TaBA%2Fd1dbb2fc1dd2b9316dce6ad4b7c863e2883b8138')\"><div class=\"image\"></div><div class=\"desc\"><div class=\"filename\"><span class=\"name\">실험분석앱</span><span class=\"type\">.html</span></div><div class=\"size\">17.89KB</div></div></a></div><div class=\"figure-file\" data-ke-type=\"file\" data-file-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/165bf321da68422034a2ee873043bee57d219cfd?download\" data-file-name=\"경사길실험_결과_2026-6-7 (2).csv\" data-file-size=\"55692\" data-mimetype=\"text/csv\" data-ke-align=\"alignCenter\"><a href=\"javascript:checkVirus('grpid%3D1TaBA%26fldid%3DfMHp%26dataid%3D1518%26fileid%3D29%26regdt%3D20260607061945&url=https%3A%2F%2Ft1.daumcdn.net%2Fcafeattach%2F1TaBA%2F165bf321da68422034a2ee873043bee57d219cfd')\"><div class=\"image\"></div><div class=\"desc\"><div class=\"filename\"><span class=\"name\">경사길실험_결과_2026-6-7 (2)</span><span class=\"type\">.csv</span></div><div class=\"size\">54.39KB</div></div></a></div><div class=\"figure-file\" data-ke-type=\"file\" data-file-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/70f24f317d2fac7bf372274e3164a40762dd968e?download\" data-file-name=\"경사길실험_샌드박스_데모.html\" data-file-size=\"51689\" data-mimetype=\"text/html\" data-ke-align=\"alignCenter\"><a href=\"javascript:checkVirus('grpid%3D1TaBA%26fldid%3DfMHp%26dataid%3D1518%26fileid%3D20%26regdt%3D20260607061945&url=https%3A%2F%2Ft1.daumcdn.net%2Fcafeattach%2F1TaBA%2F70f24f317d2fac7bf372274e3164a40762dd968e')\"><div class=\"image\"></div><div class=\"desc\"><div class=\"filename\"><span class=\"name\">경사길실험_샌드박스_데모</span><span class=\"type\">.html</span></div><div class=\"size\">50.48KB</div></div></a></div><div class=\"figure-file\" data-ke-type=\"file\" data-file-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/49845e01813d84eda70356a387524b54575f8f53?download\" data-file-name=\"마찰력탐구과정_샌드박스_데모.html\" data-file-size=\"52469\" data-mimetype=\"text/html\" data-ke-align=\"alignCenter\"><a href=\"javascript:checkVirus('grpid%3D1TaBA%26fldid%3DfMHp%26dataid%3D1518%26fileid%3D19%26regdt%3D20260607061945&url=https%3A%2F%2Ft1.daumcdn.net%2Fcafeattach%2F1TaBA%2F49845e01813d84eda70356a387524b54575f8f53')\"><div class=\"image\"></div><div class=\"desc\"><div class=\"filename\"><span class=\"name\">마찰력탐구과정_샌드박스_데모</span><span class=\"type\">.html</span></div><div class=\"size\">51.24KB</div></div></a></div><p style=\"text-align: justify;\">(교사대시번호는 5555 로 만들어 두었습니다. 샌드박스형 앱이고 실제 데이터와의 연동은 끊어놨어요. )<br>마지막에 올린 파일이 제일 위에 보이네요. 밑에 경사길실험 샌드박스 1번으로 열어 보시고 마찰력탐구과정 샌드박스를 2번으로 열어 보세요. 나머지는 보시고 싶으심 열어보세요.</p><p style=\"text-align: justify;\">&#160;<br>중1 미래엔 교과서를 사용중입니다. 이번에 동료장학으로 마찰력 알아보기 요 실험이 하고 싶어졌어요.&#160;<br>1. 웹앱 만든 배경과 과정<br>힘의 작용을 1학기로 당겨와서 교육과정 재구성 했거든요. 이 실험과 1단원의 탐구과정(2차시 밖에 안되어 탐구를 따로 진행하지 못하고 다른 주제에 녹여서 수업한다고 학기초에 안내함. )을 함께 수업하기로 함.&#160;<br>우선 최근에 에듀테크가 과연 필요할까? 내가 받고 싶은 데이터는 따로 있는데 기존의 제품이나 또 다른 선생님께서 개발하신 것들도 좋긴 하지만 딱 제 입맛에 이 수업에 이 주제에 맞지 않는게 대부분이라서 조금 무력했거든요.&#160;<br>그런데 &#46663; 학교에서 클로드를 개인개정을pro버전으로 구입을 해주셨어요. 324,000원을요!<br>저는 세특 작성에만 썼었는데, 동료 장학이 다가오고 있고 우리 학교 이은정 수석님의 얼굴을 떠올리면서 &quot;그래... 에듀테크.... 어떻게 애들 데이터를 받을까?&quot; 를 고민하다가 클로드에게 제가 수업하고 모둠별로 데이터를 받는 것을 웹앱으로 만들어 달라고 하자는 생각이 미치자,&#160;<br>정말 될까? -------&gt; 되네?-----&gt;근데 애들이 각자 다른 크롬북에서 제출해야 되는데 -----&gt; 서버가 필요하다고----&gt; firebase 나 내 구글시트로 연동----&gt; 게재를 해야 하는데 ... 유료를 유도하는 곳이 있네.&#160; 클로드야 나는 유료 안돼. 무료로 해야해 고민 그래 github----&gt; 완벽히 이해했다고 하고 항상 업그레이드 하는 클로드 덕에 여러 차례 요구 사항을 넣어가면서 수업에 적용----&gt; 선생님 얘가 샘 교사 대시보드 비번 알아내려고 합니다. ---&gt; 너 일루와... 어떻게 알려고 했어? ----&gt;시완이랑 조금 친해졌어. ----&gt; 클로드야. 학생이 내 번호를 알아내려고 하니 pinhash로 비번 보호해줘. 이렇게 해서 웹앱을 만듦.<br>&#160;</p><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/d6ad74437ea9250ea1e6c25b5352cc96f2e81249\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/d6ad74437ea9250ea1e6c25b5352cc96f2e81249\" data-origin-width=\"616\" data-origin-height=\"437\"></div><p style=\"text-align: justify;\">&#160;<br>2. 수업 구상: 경사면을 좋은 걸 샀어요. 와니 사이언스걸로 하나에 7만원대 였나? <a href=\"https://item.gmarket.co.kr/Item?goodscode=4668741292&amp;spm=gmktpc.orderlist.orderlistall.ditem12.5dca2421dmpcni\" target=\"_blank\" class=\"ke-link\">https://item.gmarket.co.kr/Item?goodscode=4668741292&amp;spm=gmktpc.orderlist.orderlistall.ditem12.5dca2421dmpcni</a> g마켓에서 구입.&#160; 각도기가 달려 있어요. (한진과학에서도 팔아요 거의 비슷한 걸로.. 훨씬 더 비싸요. 위에 고정 나사는 사실상 필요없어요. 애들이 판을 서서히 들어올리며 미끄러지기 시작하는 각도를 측정하는 거에요. 단점: 플라스틱 판이 잘 떨어진 채로 2개가 와서 교환했구요. 밑에 받침 고무판 쓰다보니 가끔 빠집니다. 그래도 거의 같은 제품에 비해 싼 편. 창조과학 제품도 12만원대) - 지금 생각하면 경사면 까지는 중1에게 버겁나? 평지에서 고리달린 나무 도막을 잡아끄는 정도만해도 되는데... 하지만 교과서에도 있고 여튼 그래도 배우는 재미는 있었어요.<br>ppt 학습 목표 얘기할 때, 잠깐이지만 임고 준비하면서 서울에서 언니 집(경사길이 매우 가파른 동네에서 겨울을 나면서 롱 부츠 신고 나가야 하는데...눈 오면 미끄러질까 잠들기 전부터 걱정하던 시절 얘기를 꺼내었답니다. )</p><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/ac2c5d862af7f7fc27fbe0823719beccbb018e8d\" class=\"txc-image\" width=\"384\" height=\"235\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/ac2c5d862af7f7fc27fbe0823719beccbb018e8d\" data-origin-width=\"990\" data-origin-height=\"607\"></div><p style=\"text-align: justify;\">그리고 저런 나무도막(플라스틱면/고무면/사포면)이 붙어있어요.&#160;<br>저걸로 거칠기/ 무게/ 면적을 조작변인으로 해보는 모둠 5개씩 총 15모둠을 데리고 실험합니다. (2인 1조)&#160;<br>하지만 정육면체다 보니 무게, 면적을 변화 시키기가 불가능해요. 미끄러지다 자빠지거든요. 두개 연결하면<br>그래서 무게와 면적을 조작 변인으로 하는 실험에서는 진열장의 젠가 조각을 이용해서 만들었어요. 때마침 경기교사노조에서 온 라벨 프린터기도 보여서 테이프로 나무도막 연결해서 뚝딱 만들고 (넓은면, 좁은면/ 가벼운것, 무거운 것)을 써 붙이고 각 각의 봉지를 5개씩 만들었어요. 뿌~듯 (찍어 놓은 사진이 없네요. 내일 가서 찍어 놔야 겠어요. 다음에 생각날 수 있게)&#160;<br>&#160;<br>그리고 실험을 설계하는 중 ... <b><i><u>&#46663; 무게 요인은 미끄러지기 시작하는 각도에 영향을 주지 않는다!니 깜짝 놀람.</u></i></b> 내가 물리 전공인데 그동안 물리랑 진짜 멀어졌구나 . 하이탑 찾아보고 샘들 글과 댓글 찾아보며 깨닫... 아, 무게가 무거워지면 당연히 최대로 낼 수 있는 마찰력이 커지지만 동시에 중력으로 인해 미끄러지려는 힘도 비례하여 커지는 구나. 마찰력도 커지지만 미끄러지려는 힘이 같이 커지니, 미끄러지기 시작하는 각도에 영향을 못주는 거였어.!&#160;<br>어렵긴 하겠지만 재밌겠어!(중학교 영역 벗어나는 건가? ㄷㄷ)<br>&#160;<br>그리고 애들이 면적은 분명히 영향없다고 나한테 배웠는데, 이렇게 묻는 아이가 있는거지. &quot; 샘, 차이가 1도 나면 영향을 주는 건가요?&quot; 아하... 차이가 전혀 안 날 수는 없지. 클로드야 이런 애한테 뭐라고 말해줘야하니 클로드가 잊고 있었던 오차 범위를 말해줍니다.<br>&#160;<br><b><i><u>같은 조건에서 오차범위를 구하고 조건이 달라졌을 때 미끄러지기 시작하는 각도의 차이를 구해서 차이가 오차 범위보다 작으면 영향을 주지 않는것! 와~ 애들한테 탐구를 진심으로 알려줄 수 있겠어. !!!!&#160;</u></i></b><br>&#160;<br>앱도 점점 발전해 갑니다.<br>&#160;<br>잠시만 그런데 대부분 애들이 평지에서 마찰력이 커질조건이 갑자기 경사길에서 무게가 안통한다고 생각하면 개념이 형성 되기도 전에 폐기 처분 되는거 아닐까?&#160; 마찰력(경사면과 평지에서 미끄러지지 않을 조건을 글과 그림으로 그리게)과 탐구과정(초성퀴즈) 퀴즈를 만들자. 마침 2학년 교무실에 크롬북 펜 있었던 거 얼른 빌려옴.&#160;<br>&#160;<br>애들이 그리기에 너무 열중한다. 그리는거 3분 이내로 하렴. 경사면만 그리고 제출하는 애들 많은데 평지도 그려야 해.&#160;<br>&#160;<br>이런 과정을 거치고 ..... 동&#47309; 장학의 그 날... 우리반 애들한테는 오차를 줄이기 위해 한 노력도 앱에다가 쓰게 하자! 내가 이걸 다 왜 했겠어? 결국 세특에 녹여야 의미가 있지... 앱을 또 업그레이드 합니다.&#160;&#160;<br>그리고 마찰력 실험 후 데이타가 들어오고나면 전체 아이들의 데이터 처리를 한 땀 한땀 쓰는게 힘들어서<br>한글작업으로 만든 한 반의 데이터 클로드야. 너가 이런식으로 데이터 처리하는 앱좀 만들어줘. 이거는 내 노트북에서만 할거야. 하니 또 뚝딱.... 구글시트에서 받아서 다운 받은 파일 끌어오기해서 연동되게 해서 만들어주네요. 방법도 클로드가 다 해! 나는 고민만 말하면 돼.<br>&#160;<br>내가 말하면 언제나 &quot; 네 완벽히 이해했습니다. 이제 만들어 보겠습니다.&quot; &quot;맞는 지적이에요. 바로 수정해 드리겠습니다&quot; 이렇게 말하니 정말<br>클로드 너만 있으면 돼!&#160;<br>모든 과정을 담을 수는 없지만 대충 글로 적어 보았어요. 선생님들도 참관 오셔서 내가 원하는 것을 내가 만들어 쓰는 게 인상적이셨다고 배우고 싶다고 해주시니 정말 뿌~듯했답니다.&#160;<br>마지막으로 샘들께 과정을 공유해 드리고 싶어서 학생 데이터 연동 안시키고 샌드박스형(데이터 저장 없는 데모앱)버전으로 다시 만들고 다운 받아서 공유 드려요. 그리고 오늘 아침에 와보니 다른 선생님들께서 만드시 웹앱에 또 감탄하고 갑니다. 게임도 해봐야 앱도 잘 만들겠구나 하고요. ㅎㅎ&#160;</p><p style=\"text-align: justify;\">&#160;</p><p style=\"text-align: justify;\">아직8반, 11반이 실험 전이기는 하지만 앱 주소 한번 올려볼게요. 이상한 것만 쓰지 말아주세요. 그리고 진짜 앱의 교사 대시 보드 비번은 미공개 입니당... 애들 세특 써야 해서요. ㅎㅎ <span data-ke-size=\"size26\"><b><a href=\"https://friction-nonslip.vercel.app/\" target=\"_blank\" class=\"ke-link\">https://friction-nonslip.vercel.app/</a></b></span></p><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/63a6e70ec8ed13a05d8dfa8eaa1ac1319499b65c\" class=\"txc-image\" width=\"337\" height=\"394\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/63a6e70ec8ed13a05d8dfa8eaa1ac1319499b65c\" data-origin-width=\"633\" data-origin-height=\"741\"></div><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/9b7f916a81a405b63dce4873f97b1fc0665d9920\" class=\"txc-image\" width=\"319\" height=\"278\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/9b7f916a81a405b63dce4873f97b1fc0665d9920\" data-origin-width=\"632\" data-origin-height=\"550\"></div><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/6dc24b9583c8175c6a155ebb41270fc315f13d7b\" class=\"txc-image\" width=\"310\" height=\"255\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/6dc24b9583c8175c6a155ebb41270fc315f13d7b\" data-origin-width=\"642\" data-origin-height=\"528\"></div><p style=\"text-align: justify;\">&#160;</p><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/1478ea28b6815d5d8a8ea998345f905a6ec03827\" class=\"txc-image\" width=\"383\" height=\"315\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/1478ea28b6815d5d8a8ea998345f905a6ec03827\" data-origin-width=\"622\" data-origin-height=\"511\"></div><p style=\"text-align: justify;\">&#160;</p><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/17991bf84d7bc37c603110505c26caf6f8e566eb\" class=\"txc-image\" width=\"396\" height=\"567\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/17991bf84d7bc37c603110505c26caf6f8e566eb\" data-origin-width=\"612\" data-origin-height=\"876\"></div><p style=\"text-align: justify;\">&#160;</p><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/df0acf3cd41a96f6adcb296ee0263e5b7e1dfdc6\" class=\"txc-image\" width=\"439\" height=\"503\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/df0acf3cd41a96f6adcb296ee0263e5b7e1dfdc6\" data-origin-width=\"656\" data-origin-height=\"751\"></div><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/51697f6d438ce6fb96cc5363525fcdab2018ee2d\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/51697f6d438ce6fb96cc5363525fcdab2018ee2d\" data-origin-width=\"338\" data-origin-height=\"402\"></div><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/f8a26f113e55d5fe9a02260170f4d7b86dcc6252\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/f8a26f113e55d5fe9a02260170f4d7b86dcc6252\" data-origin-width=\"691\" data-origin-height=\"901\"></div><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/345a936d7133ac9e68f70f65968715605bb26bb1\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/345a936d7133ac9e68f70f65968715605bb26bb1\" data-origin-width=\"653\" data-origin-height=\"877\"></div><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/a0f7b554e1ead0404c53aed723e628d8911a1013\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/a0f7b554e1ead0404c53aed723e628d8911a1013\" data-origin-width=\"643\" data-origin-height=\"872\"></div><p style=\"text-align: justify;\">퀴즈 앱은 이렇게 생겼어요.</p><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/0db054ed7252ce9646158d0b9ff2ecebeef1c346\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/0db054ed7252ce9646158d0b9ff2ecebeef1c346\" data-origin-width=\"447\" data-origin-height=\"654\"></div><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/3d490e2cbd929ecf4efefdea6e347ea150e08f45\" class=\"txc-image\" width=\"531\" height=\"596\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/3d490e2cbd929ecf4efefdea6e347ea150e08f45\" data-origin-width=\"795\" data-origin-height=\"892\"></div><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/48b73d4a5ba170e770ad40693411457a2bd42526\" class=\"txc-image\" width=\"522\" height=\"622\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/48b73d4a5ba170e770ad40693411457a2bd42526\" data-origin-width=\"748\" data-origin-height=\"891\"></div><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/5f1469a388d5a1194f3b4dffb11a45cc4712cb74\" class=\"txc-image\" width=\"526\" height=\"541\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/5f1469a388d5a1194f3b4dffb11a45cc4712cb74\" data-origin-width=\"718\" data-origin-height=\"739\"></div><p style=\"text-align: justify;\">단답형에서 채점은 띄어쓰기 정도는 무시할 수 있게 완곡한 기준을 적용해 달라고 했어요. 엄격하게 채점하면 정답 맞추기 힘들것 같아요.&#160;<br>제출하기 누르면 바로 정답도 보이고 자신의 점수도 보여요. 문제가 4개면 한 개당 25점씩, 문제가 3개면 33점씩 주도록 만들었네요.&#160;<br>교사 대시보드에서 애들의 그림과 단답형의 순위도 볼 수 있어요.&#160;</p><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/58747fb24bb230d7492ee9a297201cc2620fda13\" class=\"txc-image\" width=\"473\" height=\"345\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/58747fb24bb230d7492ee9a297201cc2620fda13\" data-origin-width=\"1017\" data-origin-height=\"742\"></div><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/3250381a242514eab500f19317599c5154ba1ab9\" class=\"txc-image\" width=\"436\" height=\"222\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/3250381a242514eab500f19317599c5154ba1ab9\" data-origin-width=\"957\" data-origin-height=\"487\"></div><p style=\"text-align: justify;\">다 맞으면 199점이 되어요. 그러면 또 알아서 먼저 맞춘 팀을 1위가 되게 만들어 줬어요.&#160;<br>샌드박스형으로 만든 앱 체험해 보세요. 실제 이 앱은 firebase나 구글시트와의 연동 끊어놨어요. 샘들께서 학생도 해보시고 교사도 해보시면서 이런거구나 보실 수 있으실 거에요.<br>이제 노션도 알아보고 싶고 클로드 디자인도 영역을 넓히면서 알아가 보고 싶네요. 까막눈 벗어난 것을 너무 자랑 하네요.<br>좋은 주말 보내세요.&#160;<br>&#160;<br>&#160;<br>--- 추가-----<br>데이터 분석앱은 이렇게 생겼어요.&#160;</p><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/3ad9ddba3c03b1b016c35a1e5327e87c1814a315\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/3ad9ddba3c03b1b016c35a1e5327e87c1814a315\" data-origin-width=\"1091\" data-origin-height=\"366\"></div><p style=\"text-align: justify;\">여기에 교사대시보드에서 다운 받은 엑셀파일을 끌어다 놓기만 하면 전체 결과를 볼 수 있어요.&#160;<br>&#160;</p><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/6c1c2ec72aea5658b544bc9a8db5e23b56bbaa2c\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/6c1c2ec72aea5658b544bc9a8db5e23b56bbaa2c\" data-origin-width=\"918\" data-origin-height=\"910\"></div><p style=\"text-align: justify;\">반 별로도 볼 수 있어요.&#160;</p><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/f411eef1874154b74d8d6d7c0044e67b4002b1f8\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/f411eef1874154b74d8d6d7c0044e67b4002b1f8\" data-origin-width=\"884\" data-origin-height=\"884\"></div><p style=\"text-align: justify;\">전체 경향성, 다른반은 이렇게 결과가 나왔어라고 보여 줍니다. 제가 애들의 실험이 얼마나 정교했나를 볼 때는교사 대시보드에서 그모둠의 상세버전을 클릭해서 오차 범위를 봅니다. 그리고 실험 여러 번 하면 사포가 부드러워져요(나무가루가 사이에 낌) 그래서 다른 반 수업엔 다른 육면체로 바꿔주면 좋아요. 갯수가 넘치거든요. 습도가 높은 날에는 고무면이 끈적해서 먼지도 달라붙어서인지 미끄러지기 시작하는 각도가 커져요. 이런 것도 애들이랑 얘기해 볼 수 있어요.&#160;</p>\n\t \t\t\t\t\t<!-- -->"
}