=\"0\" scrolling=\"no\" allowfullscreen=\"\" allow=\"encrypted-media\"></iframe><div class=\"figcaption\"></div></div><div class=\"figure-video\" data-ke-type=\"video\" data-video-url=\"https://kakaotv.daum.net/embed/player/cliplink/rva797b38q396exq276vx7nry@my?service=daum_cafe\" data-video-host=\"kakaotv\" data-video-play-service=\"daum_cafe\" data-video-width=\"712\" data-video-height=\"400\" data-ke-style=\"alignCenter\" data-video-thumbnail=\"https://thumb.kakaocdn.net/dna/kamp/source/rva797b38q396exq276vx7nry/thumbs/2.jpg?credential=TuMuFGKUIcirOSjFzOpncbomGFEIdZWK&amp;expires=33272049900&amp;signature=4U5lGgi%2BHqUlGld%2BABBs3me0QCs%3D\" data-ke-mobile-mobilestyle=\"widthFull\" data-video-origin-width=\"712\" data-video-origin-height=\"400\"><iframe src=\"https://kakaotv.daum.net/embed/player/cliplink/rva797b38q396exq276vx7nry?service=daum_cafe&amp;f=p&amp;ptoken=eyJhbGciOiJIUzUxMiIsInR5cCI6IkpXVCJ9.eyJpZCI6InJ2YTc5N2IzOHEzOTZleHEyNzZ2eDducnkiLCJ0aWQiOiJhYmI2NTI0Yi1lNWJlLTQxZTktOTlhYS1lYWFjZGY4NGU3OGMiLCJhcHBfaWQiOiJkYXVtX2NhZmUiLCJleHAiOjE3ODYxODQwMzd9.uFeStAbbkqNniWmobx1y8AX-6USx0JlCGVuKDKHuewcojcsoE0yRLIEhpcrkOWbdL9jpUGEHOH54FK1IO-5yMg&amp;autoplay=0\" width=\"712\" height=\"400\" frameborder=\"0\" scrolling=\"no\" allowfullscreen=\"\" allow=\"encrypted-media\"></iframe><div class=\"figcaption\"></div></div><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/a3a099b8608b6ba5d5354b41b911d95fa53d66b9\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/a3a099b8608b6ba5d5354b41b911d95fa53d66b9\" data-origin-width=\"1280\" data-origin-height=\"1280\"></div><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/7aface6271d6ab8dd72b59790421334f4eeed1ec\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/7aface6271d6ab8dd72b59790421334f4eeed1ec\" data-origin-width=\"768\" data-origin-height=\"1024\"></div><p>아이들이 작품이 올라간 패들렛입니다. 아이들의 개인정보가 있으니 눈으로 확인부탁드립니다!</p><p><a href=\"https://padlet.com/parkuhyeon/padlet-rv36ic7mu9gsx1na\" target=\"_top\" class=\"ke-link\">https://padlet.com/parkuhyeon/padlet-rv36ic7mu9gsx1na</a></p><div class=\"figure-open\" contenteditable=\"false\" data-ke-type=\"opengraph\" data-ke-align=\"alignCenter\" data-og-type=\"website\" data-og-title=\"확산, 증발 애니메이션으로 표현하기\" data-og-description=\"제목은 학번+이름\" data-og-host=\"padlet.com\" data-og-source-url=\"https://padlet.com/parkuhyeon/padlet-rv36ic7mu9gsx1na\" data-og-url=\"https://padlet.com/parkuhyeon/padlet-rv36ic7mu9gsx1na\" data-og-image=\"https://scrap.kakaocdn.net/dn/bGN2ui/hyVZgsUqeI/weWZpPyRepWWDAHk1aDvv0/img.jpg?width=1200&amp;height=600&amp;face=0_0_1200_600,https://scrap.kakaocdn.net/dn/bRHKIr/hyV2qglPLp/kNhPTP2Q2u5p5UJ96u2bcK/img.jpg?width=1200&amp;height=600&amp;face=0_0_1200_600\"><a href=\"https://padlet.com/parkuhyeon/padlet-rv36ic7mu9gsx1na\" target=\"_blank\" data-source-url=\"https://padlet.com/parkuhyeon/padlet-rv36ic7mu9gsx1na\"><div class=\"og-image\"><img src=\"https://scrap.kakaocdn.net/dn/bGN2ui/hyVZgsUqeI/weWZpPyRepWWDAHk1aDvv0/img.jpg?width=1200&amp;height=600&amp;face=0_0_1200_600,https://scrap.kakaocdn.net/dn/bRHKIr/hyV2qglPLp/kNhPTP2Q2u5p5UJ96u2bcK/img.jpg?width=1200&amp;height=600&amp;face=0_0_1200_600\" alt=\"\" xxxxonerror=\"this.src=&quot;//img1.kakaocdn.net/thumb/C200x200/?fname=https%3A%2F%2Ft1.daumcdn.net%2Fcafe_image%2Fcafe_meta_image_190529.png&quot;\"></div><div class=\"og-text\"><p class=\"og-title\">확산, 증발 애니메이션으로 표현하기</p><p class=\"og-desc\">제목은 학번+이름</p><p class=\"og-host\">padlet.com</p></div></a></div><p>&#160;</p><p>항상 재과만에서 좋은 수업자료로 도움 받고 있다가 처음으로 글을 올려봅니다.</p><p>선생님들께도 작은 도움이 되었으면 좋겠습니다^_^</p><p>&#160;</p>\n\t \t\t\t\t\t<!-- -->",
