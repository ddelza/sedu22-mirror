  "boardName": "중학교 화학수업 이야기",
  "title": "화학반응의 규칙과 에너지 변화, 단원에서 배우는 것을 하나의 이야기로",
  "author": "이승윤(선덕중)",
  "userid": "DRVD",
  "created": "24.03.05",
  "viewCnt": 2316,
  "commentCnt": 15,
  "headCont": "화학반응규칙",
