ata-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/83c198311e5ad31a815f15dc6e591e930668173c\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/83c198311e5ad31a815f15dc6e591e930668173c\" data-origin-width=\"4032\" data-origin-height=\"1908\"></div><p style=\"text-align: left;\"><span data-ke-size=\"size16\"></span></p>\n\t \t\t\t\t\t<!-- -->",
