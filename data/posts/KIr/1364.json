 } ] } ] }, \"01D66941D5239D0000000004\": { \"np\": \"01D66941D5239D0000000005\", \"id\": -2147483648, \"pp\": \"01D66941D523C41000000022\", \"si\": \"01D66941D523C41000000023\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D66941D523C4100000001C\", \"ch\": [ { \"t\": \"  복직이 가능하다는 진단을 받으면서부터 2학기 수업을 염두에 두고 생활하였습니다. 교단에 처음 섰을 때 공책에 수업 순서를 기록하는 습관이 있었습니다. 일종의 가상 수업 시나리오입니다. 이것을 완성한 후 학교에 제출할 학습지도안을 작성하였거든요. \" } ] } ] }, \"01D66941D5239D0000000005\": { \"np\": \"01D66941D5239D0000000006\", \"id\": -2147483648, \"pp\": \"01D66941D523C41000000022\", \"si\": \"01D66941D523C41000000023\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D66941D523C4100000001C\", \"ch\": [ { \"t\": \"  초심으로 돌아가 예전의 방법대로 가상 수업 작업을 시작하였습니다. 특히 도입 부분 아이디어를 찾고자 노력을 기울였지요. 자리에 오래 앉을 수 있는 컨디션과는 거리가 멀어 쉬엄쉬엄 일하였습니다. \" } ] } ] }, \"01D66941D5239D0000000006\": { \"np\": \"01D66941D5239D0000000007\", \"id\": -2147483648, \"pp\": \"01D66941D523C41000000022\", \"si\": \"01D66941D523C41000000023\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D66941D523C4100000001C\", \"ch\": [ { \"t\": \"\" } ] } ] }, \"01D66941D5239D0000000007\": { \"np\": \"01D66941D5239D0000000008\", \"id\": -2147483648, \"pp\": \"01D66941D523C41000000022\", \"si\": \"01D66941D523C41000000023\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D66941D523C4100000001C\", \"ch\": [ { \"t\": \"  한 학기 동안 네 번의 입원 그리고 통원 치료 중에 보고 겪었던 일들로 큰 교훈을 얻었습니다. 그동안 제가 학생들을 어떻게 대하였는지 반성하며 돌아보게 되더군요. 훌륭한 의료진과 운영 시스템을 갖춘 다른 병원도 있었지만 여태껏 통원치료를 받고 있는 ㅅㅁ병원 이야기를 할게요. \" } ] } ] }, \"01D66941D5239D0000000008\": { \"np\": \"01D66941D5239D0000000009\", \"id\": -2147483648, \"pp\": \"01D66941D523C41000000022\", \"si\": \"01D66941D523C41000000023\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D66941D523C4100000001C\", \"ch\": [ { \"t\": \"\" } ] } ] }, \"01D66941D5239D0000000009\": { \"np\": \"01D66941D5239D000000000A\", \"id\": -2147483648, \"pp\": \"01D66941D523C41000000022\", \"si\": \"01D66941D523C41000000023\", \"bf\": 0, \"ru\": [ { \"cp\": \"01D66941D523C4100000001C\", \"ch\": [ { \"t\": \"  검사실 선생님들이 몸을 제대로 