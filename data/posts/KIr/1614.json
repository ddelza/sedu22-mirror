t1.daumcdn.net/cafeattach/1TaBA/af5f92ca1a8e39049008e249d85901cdf126c28e\" data-origin-width=\"4000\" data-origin-height=\"2250\"></div><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/be4e947d27ff478183e43b0f8cde5994defcf88c\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/be4e947d27ff478183e43b0f8cde5994defcf88c\" data-origin-width=\"4000\" data-origin-height=\"2250\"></div><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/34e7a77fcf83ca3036239a8649266afb6054f649\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/34e7a77fcf83ca3036239a8649266afb6054f649\" data-origin-width=\"4000\" data-origin-height=\"2250\"></div><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/231ce6858d42517d204ff734c605c865312837b1\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/231ce6858d42517d204ff734c605c865312837b1\" data-origin-width=\"4000\" data-origin-height=\"2250\"></div><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/c9739866e93e041e5b9216faef3de3e8354cafc6\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/c9739866e93e041e5b9216faef3de3e8354cafc6\" data-origin-width=\"4000\" data-origin-height=\"2250\"></div><div class=\"figure-img\" data-ke-type=\"image\" data-ke-style=\"alignCenter\" data-ke-mobilestyle=\"widthOrigin\"><img src=\"https://t1.daumcdn.net/cafeattach/1TaBA/924a82559fe27aff18bbd1e44146760f8404dcb8\" class=\"txc-image\" data-img-src=\"https://t1.daumcdn.net/cafeattach/1TaBA/924a82559fe27aff18bbd1e44146760f8404dcb8\" data-origin-width=\"4000\" data-origin-height=\"2250\"></div><p>&#160;</p><p>전투기를 좋아하는 과학쌤 1인이 저희반 대상으로 한 프로그램입니다.</p><p>&#160;</p><p>&#160;</p>\n\t \t\t\t\t\t<!-- -->",
